# Supabase (produção). Deixe em branco pra rodar em modo local.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxx

# Modo local: roda a fila 100% no navegador (localStorage), sem Supabase.
# Útil pra desenvolver/testar. Descomente pra forçar mesmo com Supabase configurado.
# VITE_LOCAL=1
